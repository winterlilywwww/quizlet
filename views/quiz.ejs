<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Quiz Selection</title>
    <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css"> <!-- Link to your CSS file -->
</head>

<body>
    <header>
        <nav>
            <ul class="nav-links">
                <li class="nav-item"><a href="/">Home</a></li>
                <li class="nav-item"><a href="/about">About</a></li>
                <li class="nav-item"><a href="/quiz">Quiz</a></li>
                <li class="nav-item"><a href="/result">Result</a></li>
            </ul>
        </nav>
        <br> </br>

        <form action="/api" method="post" class="container">



            <h1 class="glitch-text" data-text="Select Quiz Option"> Select Quiz Option</h1>

            <!-- Difficulty Hover Selection -->
            <div class="option-container">
                <h2>Select Difficulty:</h2>
                <div class="option difficulty" id="difficulty">
                    <span data-value="easy">Easy</span>
                    <span data-value="medium">Medium</span>
                    <span data-value="hard">Hard</span>
                </div>
            </div>

            <!-- Start Button -->
            <button type="submit" class="start-btn">Start Quiz</button>

        </form>

        <script>
            // Variables to hold the user's choices
            let selectedDifficulty = 'easy';
            let selectedType = 'boolean';

            // Update selected option on hover for difficulty
            document.querySelectorAll('.difficulty span').forEach(option => {
                option.addEventListener('mouseover', function () {
                    highlightSelection('difficulty', this.getAttribute('data-value'));
                });
                option.addEventListener('click', function () {
                    selectedDifficulty = this.getAttribute('data-value');
                    applyBox('difficulty', selectedDifficulty);
                });
            });

            // Update selected option on hover for quiz type
            document.querySelectorAll('.type span').forEach(option => {
                option.addEventListener('mouseover', function () {
                    highlightSelection('type', this.getAttribute('data-value'));
                });
                option.addEventListener('click', function () {
                    selectedType = this.getAttribute('data-value');
                    applyBox('type', selectedType);
                });
            });

            // Highlight selected option
            function highlightSelection(optionType, selectedValue) {
                document.querySelectorAll(`.${optionType} span`).forEach(span => {
                    span.classList.toggle('highlight', span.getAttribute('data-value') === selectedValue);
                });
            }

            // Apply box to selected option
            function applyBox(optionType, selectedValue) {
                document.querySelectorAll(`.${optionType} span`).forEach(span => {
                    span.classList.remove('selected');
                    if (span.getAttribute('data-value') === selectedValue) {
                        span.classList.add('selected');
                    }
                });
            }

            // Start quiz button functionality
            // document.getElementById('start-btn').addEventListener('click', function () {
            //     localStorage.setItem('quizDifficulty', selectedDifficulty);
            //     localStorage.setItem('quizType', selectedType);

            //     window.location.href = '/start';
            // });
        </script>
</body>

</html>

<style>
    /* General styling */
    body {
        font-family: 'Roboto', sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-image: url(/images/bg.png);
        color: #00ffff;
        margin: 0;
    }

    .container {
        text-align: center;
        max-width: 400px;
    }


    /* Navigation */
    nav {
        width: 100%;
        background-color: rgba(255, 255, 255, 0.05);
