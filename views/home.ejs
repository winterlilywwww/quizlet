<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Homepage</title>
    <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1 class="glitch-text" data-text="Computer Quiz">Computer Quiz</h1>
        </header>

        <nav>
            <ul class="nav-links">
                <li class="nav-item"><a href="/">Home</a></li>
                <li class="nav-item"><a href="about">About</a></li>
                <li class="nav-item"><a href="/quiz">Quiz</a></li>
                <li class="nav-item"><a href="/results">Result</a></li>
            </ul>
        </nav>

        <section class="content">
            <p>Welcome, <strong><%= user ? user.name : 'Guest' %></strong>!</p>
            <p>Your email: <%= user ? user.email : 'Not available' %></p>
            <p>Your section: <%= user ? user.section : 'Not available' %></p>
            <p>Your latest quiz score: <%= user ? user.score : 'Not attempted yet' %></p>
            
        </section>
        
    </div>
</body>
</html>


<style>
 
/* General Styles */
body {
    margin: 0;
    padding: 0;
    font-family: 'VT323', monospace;
    background-image: url(/images/bg.png);
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #fff;
}

/* Container Styling */
.container {
    text-align: center;
    padding: 30px;
    background-color: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    width: 80%;
    max-width: 800px;
}

/* Header (Glitch Effect for h1) */
header h1 {
    font-size: 3em;
    color: #fff;
    position: relative;
    margin-bottom: 50px;
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.8);
}

/* Navigation */
nav {
    margin: 40px 0;
}

/* Navigation List */
.nav-links {
    list-style-type: none;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 20px; /* Adds space between the nav items */
}

/* Each Navigation Item */
.nav-item {
    padding: 10px 20px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid #00ffff;
    border-radius: 8px;
    transition: background-color 0.3s ease, transform 0.3s ease;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
}

.nav-item:hover {
    background-color: rgba(255, 0, 255, 0.1);
    transform: translateY(-5px);
    box-shadow: 0 0 15px rgba(255, 0, 255, 0.5);
}

/* Navigation Links */
.nav-links a {
    text-decoration: none;
    font-family: 'Roboto', sans-serif; /* Clean modern font for nav */
    font-size: 1.5em;
    color: #00ffff;
    text-shadow: 0 0 5px rgba(0, 255, 255, 0.8);
    transition: color 0.3s, text-shadow 0.3s;
}

.nav-links a:hover {
    color: #ff00ff;
    text-shadow: 0 0 15px rgba(255, 0, 255, 0.8);
}

/* Content Section */
.content p {
    font-size: 1.2em;
    color: #ddd;
    margin-top: 30px;
    animation: fadeIn 2s ease;
}

/* Fade-in Animation */
@keyframes fadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
}

/* Responsive Design */
@media (max-width: 768px) {
    header h1 {
        font-size: 2.5em;
    }

    .nav-links {
        flex-direction: column;
    }

    .nav-item {
        margin-bottom: 20px;
    }

    .nav-links a {
        font-size: 1.2em;
    }

    .content p {
        font-size: 1em;
    }
}

/* Header (Glitch Effect for h1) */
header h1 {
    font-size: 3em;
    color: #fff;
    position: relative;
    margin-bottom: 50px;
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.8);
}

header h1::before, header h1::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    color: #f00;
    z-index: -1;
    overflow: hidden;
    clip: rect(0, 900px, 0, 0);
}

header h1::before {
    left: 2px;
    text-shadow: -2px 0 cyan;
    animation: glitch-anim-1 2s infinite linear alternate-reverse;
}

header h1::after {
    left: -2px;
    text-shadow: -2px 0 lime;
    animation: glitch-anim-2 1.5s infinite linear alternate-reverse;
}

/* Glitch Animations */
@keyframes glitch-anim-1 {
    0% { clip: rect(44px, 9999px, 56px, 0); transform: skew(0.3deg); }
    20% { clip: rect(65px, 9999px, 25px, 0); transform: skew(0.6deg); }
    40% { clip: rect(16px, 9999px, 90px, 0); transform: skew(0.1deg); }
    60% { clip: rect(42px, 9999px, 12px, 0); transform: skew(0.2deg); }
    80% { clip: rect(10px, 9999px, 65px, 0); transform: skew(0.4deg); }
    100% { clip: rect(90px, 9999px, 33px, 0); transform: skew(0.5deg); }
}

@keyframes glitch-anim-2 {
    0% { clip: rect(12px, 9999px, 75px, 0); transform: skew(0.4deg); }
    20% { clip: rect(53px, 9999px, 85px, 0); transform: skew(0.1deg); }
    40% { clip: rect(22px, 9999px, 66px, 0); transform: skew(0.6deg); }
    60% { clip: rect(30px, 9999px, 100px, 0); transform: skew(0.2deg); }
    80% { clip: rect(55px, 9999px, 20px, 0); transform: skew(0.3deg); }
    100% { clip: rect(22px, 9999px, 75px, 0); transform: skew(0.5deg); }
}
</style>